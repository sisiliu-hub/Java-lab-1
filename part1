package com.example;

import java.util.Arrays;

public class lab1 {

    public static void main(String[] args) {

        // Step 1: Create two integer arrays
        int[] x = {3, 5, 7, 4, 9};
        int[] y = {4, 5, 9, 2, 7};

        // Step 2: Create array z with 5 elements
        int[] z = new int[5];

        // Step 3: Find the maximum of corresponding elements
        for (int i = 0; i < 5; i++) {
            z[i] = Math.max(x[i], y[i]);
        }

        // Step 4: Print the arrays
        System.out.println("Array x = " + Arrays.toString(x));
        System.out.println("Array y = " + Arrays.toString(y));
        System.out.println("Array z = x + y = " + Arrays.toString(z));
    }
}
